# Claude — ou rode `ant auth login` e deixe vazio
ANTHROPIC_API_KEY=

# Postgres (docker compose up -d sobe um local com estes dados)
DATABASE_URL=postgres://sre:sre@localhost:5432/sre_agent

# Segredo compartilhado com quem envia o webhook (incident.io, PagerDuty, Datadog...)
WEBHOOK_SECRET=troque-por-um-valor-longo-e-aleatorio

# Leitura de PRs/deploys: token de GitHub App (ou PAT fine-grained) SÓ com leitura
GITHUB_TOKEN=

# Publicação do relatório. Vazio = imprime no stdout em vez de postar
SLACK_BOT_TOKEN=

# shadow (padrão) = investiga e salva, mas não publica. slack = publica no canal do incidente.
PUBLISH_MODE=shadow

# Rastreio (escolha um; nada configurado = desligado)
#   Langfuse (cloud ou self-hosted):
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
#   ou qualquer backend OTLP/HTTP (Jaeger local: docker compose --profile tracing up -d):
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# content = exporta também prompts, respostas e argumentos das tools. Só em backend que você controla.
TRACE_CONTENT=metadata_only
# Link no relatório e no review, ex.: https://cloud.langfuse.com/project/<id>/traces/{traceId}
TRACE_URL_TEMPLATE=

# Onde o intake cria os Jobs. "local" roda a investigação no mesmo processo (dev)
DISPATCH_MODE=local
JOB_NAMESPACE=sre-agent
JOB_IMAGE=ghcr.io/sua-org/sre-agent:latest

# Inventário de produtos e integrações (ver agent.config.example.json)
AGENT_CONFIG_FILE=./agent.config.json
