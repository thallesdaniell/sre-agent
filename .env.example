# Claude — ou rode `ant auth login` e deixe vazio
ANTHROPIC_API_KEY=

# Segredo compartilhado com quem envia o webhook (incident.io, PagerDuty, Datadog...)
WEBHOOK_SECRET=troque-por-um-valor-longo-e-aleatorio

# Leitura de PRs/deploys: token de GitHub App (ou PAT fine-grained) SÓ com leitura
GITHUB_TOKEN=

# Publicação do relatório. Vazio = imprime no stdout em vez de postar
SLACK_BOT_TOKEN=

# Onde o intake cria os Jobs. "local" roda a investigação no mesmo processo (dev)
DISPATCH_MODE=local
JOB_NAMESPACE=sre-agent
JOB_IMAGE=ghcr.io/sua-org/sre-agent:latest

# Inventário de produtos e integrações (ver agent.config.example.json)
AGENT_CONFIG_FILE=./agent.config.json
